PORT=8787
# The API key is generated in .state/api-key if unset.
# GROK_PROXY_KEY=
# Use a dedicated state directory, never your everyday Chrome profile.
GROK_STATE_DIR=.state
GROK_CHROME_CHANNEL=chrome
# Login opens Chrome; proxy requests always run headlessly.
GROK_MODE=fast
# Optional: set before first login; saved per account and reused by requests.
# Defaults come from the local OS. Keep them consistent with your environment.
# GROK_LOCALE=ru-RU
# GROK_TIMEZONE=Europe/Berlin
GROK_TIMEOUT_MS=180000
# Fallback pause when upstream gives no Retry-After; this is a local policy.
GROK_COOLDOWN_MS=300000
# Safe request/account events only; no prompts, cookies or tokens.
GROK_LOG_FILE=log.json
# Optional override for a verified gateway completion event.
# GROK_DONE_EVENT=response.done,response.completed
